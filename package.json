  "dependencies": {
    "@google/genai": "^2.24.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.10",
    "ink": "^5.1.2",
    "ink-spinner": "^5.0.0",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "typescript": "^5.5.2",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.3",
    "@xterm/headless": "^6.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.16.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
