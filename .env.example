# Clé API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle par défaut — voir `fuller --list-models` (ex. gemini-3.6-flash, gemini-3.8-flash, gemini-3.1-pro-preview, gemini-pro-latest)
GEMINI_MODEL=gemini-3.6-flash

# Optionnel : taille de la fenêtre de contexte utilisée pour la jauge et l'auto-compaction
# FULLER_CONTEXT_WINDOW=1048576

# Optionnel : désactiver le recalcul des lignes repliées au redimensionnement (terminaux sans repli d'historique)
# FULLER_NO_REFLOW=1

# Optionnel : plusieurs clés, séparées par des virgules. Quand une clé atteint son quota,
# Fuller passe aussitôt à la suivante (la clé épuisée est mise de côté le temps indiqué par Google).
# GEMINI_API_KEYS=cle1,cle2,cle3
